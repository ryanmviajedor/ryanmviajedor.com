# ─── Contact form email (Resend) ────────────────────────────────────────────
# All three are optional together. Leave RESEND_API_KEY unset and the contact
# form still works — submissions are validated, accepted, and logged to the
# server console. Set RESEND_API_KEY and the other two become required;
# src/lib/env.ts fails the boot loudly rather than silently dropping enquiries.

# https://resend.com/api-keys
RESEND_API_KEY=

# Sender. Must be a domain verified in Resend, OR Resend's test sender below.
# Test sender caveat: it ONLY delivers to your own Resend account email, so the
# enquirer acknowledgement will be rejected until you verify a real domain.
CONTACT_FROM_EMAIL="Ryan Viajedor <onboarding@resend.dev>"

# Where enquiry notifications land. On the test sender this MUST be the email
# you signed up to Resend with, or nothing is delivered.
CONTACT_TO_EMAIL=
